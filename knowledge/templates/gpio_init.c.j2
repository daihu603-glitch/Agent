/**
 * GPIO 初始化 — 由嵌入式智能体自动生成
 * 芯片: STM32F103VET6 (HAL)
 */
#include "main.h"

void MX_GPIO_Init(void)
{
    GPIO_InitTypeDef GPIO_InitStruct = {0};

    /* 使能 GPIO 时钟 */
{% set ns = namespace(ports=[]) %}
{% for pin in pins %}
{% if pin.pin[1] not in ns.ports %}
{% set ns.ports = ns.ports + [pin.pin[1]] %}
{% endif %}
{% endfor %}
{% for port in ns.ports %}
    __HAL_RCC_GPIO{{ port }}_CLK_ENABLE();
{% endfor %}

{% for pin in pins %}
    /* {{ pin.pin }}{% if pin.label %} — {{ pin.label }}{% endif %} */
{% if 'Output' in pin.mode %}
    GPIO_InitStruct.Pin = GPIO_PIN_{{ pin.pin[2:] }};
    GPIO_InitStruct.Mode = GPIO_MODE_OUTPUT_PP;
    GPIO_InitStruct.Pull = {{ pin.pull | default('GPIO_NOPULL', true) }};
    GPIO_InitStruct.Speed = {{ pin.speed | default('GPIO_SPEED_FREQ_LOW', true) }};
    HAL_GPIO_Init(GPIO{{ pin.pin[1] }}, &GPIO_InitStruct);
    HAL_GPIO_WritePin(GPIO{{ pin.pin[1] }}, GPIO_PIN_{{ pin.pin[2:] }}, GPIO_PIN_RESET);

{% elif 'Input' in pin.mode %}
    GPIO_InitStruct.Pin = GPIO_PIN_{{ pin.pin[2:] }};
    GPIO_InitStruct.Mode = GPIO_MODE_INPUT;
    GPIO_InitStruct.Pull = {{ pin.pull | default('GPIO_NOPULL', true) }};
    HAL_GPIO_Init(GPIO{{ pin.pin[1] }}, &GPIO_InitStruct);

{% elif 'EXTI' in pin.mode or 'Interrupt' in pin.mode %}
    GPIO_InitStruct.Pin = GPIO_PIN_{{ pin.pin[2:] }};
    GPIO_InitStruct.Mode = GPIO_MODE_IT_FALLING;
    GPIO_InitStruct.Pull = {{ pin.pull | default('GPIO_PULLUP', true) }};
    HAL_GPIO_Init(GPIO{{ pin.pin[1] }}, &GPIO_InitStruct);
    HAL_NVIC_SetPriority(EXTI{{ pin.pin[2:] }}_IRQn, 2, 0);
    HAL_NVIC_EnableIRQ(EXTI{{ pin.pin[2:] }}_IRQn);

{% elif 'Analog' in pin.mode %}
    GPIO_InitStruct.Pin = GPIO_PIN_{{ pin.pin[2:] }};
    GPIO_InitStruct.Mode = GPIO_MODE_ANALOG;
    GPIO_InitStruct.Pull = GPIO_NOPULL;
    HAL_GPIO_Init(GPIO{{ pin.pin[1] }}, &GPIO_InitStruct);

{% elif 'Alternate' in pin.mode or 'AF' in pin.mode %}
    GPIO_InitStruct.Pin = GPIO_PIN_{{ pin.pin[2:] }};
    GPIO_InitStruct.Mode = GPIO_MODE_AF_PP;
    GPIO_InitStruct.Pull = {{ pin.pull | default('GPIO_PULLUP', true) }};
    GPIO_InitStruct.Speed = GPIO_SPEED_FREQ_HIGH;
    HAL_GPIO_Init(GPIO{{ pin.pin[1] }}, &GPIO_InitStruct);

{% endif %}
{% endfor %}
}